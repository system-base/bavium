# =============================================================================
# Bavium — Example Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values where needed.
# Local-only gelistirme yapsan bile Convex icin bir cloud deployment gerekir.
# `npx convex dev` calistirdiginda Convex genelde asagidaki iki satiri yazar:
# - CONVEX_DEPLOYMENT
# - NEXT_PUBLIC_CONVEX_URL
# =============================================================================

# ── Network ───────────────────────────────────────────────────────────────────
# Safe default for development.
NEXT_PUBLIC_NETWORK_ID=base-sepolia

# Optional client-side RPC overrides for public reads.
# These values are bundled into the browser, so do NOT put private/provider-secret
# endpoints here. Use only client-safe public URLs.
# Bavium already falls back to official Base public RPCs plus known public backups.
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Optional server-side mainnet RPC just for ENSIP-19 / Basename resolution.
# Base docs recommend a private Ethereum mainnet RPC for better reliability.
BASENAME_MAINNET_RPC_URL=

# ── WalletConnect (Reown) ─────────────────────────────────────────────────────
# Free project ID: https://dashboard.reown.com
# Dev icin bos birakma; kendi project ID'nizi koyun.
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_PROJECT_ID

# ── App URL ───────────────────────────────────────────────────────────────────
# Public app URL used by the frontend.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Base Builder Code for ERC-8021 attribution on web clients.
# Get this from base.dev -> Settings -> Builder Code.
# This value is public and safe for NEXT_PUBLIC_* usage.
# Leave empty until Bavium is registered on base.dev.
NEXT_PUBLIC_BASE_BUILDER_CODE=

# Backend-facing app URL used by Convex scheduler actions to call the
# secure automation check route. In production this should be a public URL.
# In local development, localhost values will be skipped by Convex cron.
APP_URL=http://localhost:3000

# ── Session Auth ──────────────────────────────────────────────────────────────
# Dev'de kod fallback secret kullanabiliyor ama bunu acikca set etmek daha iyi.
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=replace-with-a-random-secret

# ── Scheduler Security ────────────────────────────────────────────────────────
# Convex cron -> Next.js secure scheduler endpoint auth secret.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-secret

# ── Convex Deployment ─────────────────────────────────────────────────────────
# `npx convex dev` sonrasinda Convex tarafindan set edilir.
# Example values are placeholders.
CONVEX_DEPLOYMENT=dev:replace-with-your-convex-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://replace-with-your-deployment.convex.cloud
CONVEX_SERVER_SECRET=replace-with-a-random-secret

# ── Across Bridge API (optional, not required for current read-only skills) ───
# Leave these empty for the current local/free-tier workflow.
# Bavium bridge skills use public read-only endpoints and must keep working
# without an Across key. These fields are reserved only if a future public
# production integration explicitly needs official integrator credentials.
# Integrator ID, when used, must be a 2-byte hex string such as 0xdead.
ACROSS_API_KEY=
ACROSS_INTEGRATOR_ID=
